{
  "name": "meeting-translator",
  "version": "1.0.0",
  "description": "Real-time meeting translator with speaker profile support",
  "main": "electron/main.js",
  "scripts": {
    "dev": "NODE_ENV=development concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:8000/health http://localhost:5173 && electron .\"",
    "dev:backend": "cd backend && python3 main.py",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && pyinstaller backend.spec --distpath ../backend-dist --workpath ../build/backend-work --noconfirm",
    "build:win": "npm run build:frontend && npm run build:backend && electron-builder --win",
    "build:mac": "npm run build:frontend && npm run build:backend && electron-builder --mac",
    "build:all": "npm run build:frontend && npm run build:backend && electron-builder --mac --win"
  },
  "build": {
    "appId": "com.meetingtranslator.app",
    "productName": "Meeting Translator",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "backend-dist/backend",
        "to": "backend-dist",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  }
}
